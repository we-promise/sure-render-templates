#!/usr/bin/env bash
# Test double for curl, used only by tests/unit/e2e-orchestration.bats. Plays
# the Render API for the real tests/render/e2e.sh and teardown.sh: records every
# call in $STUB_DIR/calls.log and answers from canned, shape-accurate bodies.
#   STUB_FAIL_JOB   a one-off job whose command contains this text ends "failed"
#   STUB_DEPLOY_FAIL=transient    initial deploys end update_failed and the
#       service logs show a DB connection refusal; the retry deploy goes live
#   STUB_DEPLOY_FAIL=persistent   initial deploys end update_failed with
#       generic logs; no retry may happen
#   STUB_DEPLOY_FAIL=repeated     like transient, but the retry deploy also
#       ends update_failed; exactly one retry may happen, then red
set -u
out=""; method=GET; url=""; body=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift ;;
    -X) method="$2"; shift ;;
    --data-binary) body="$2"; shift ;;
    -w|-H|--connect-timeout|--max-time) shift ;;
    -*) ;;
    *) url="$1" ;;
  esac
  shift
done
path="${url#*/v1}"
echo "$method $path" >> "$STUB_DIR/calls.log"
code=200; resp='{}'
case "$method $path" in
  "POST /postgres") resp='{"id":"pg-1"}' ;;
  "POST /key-value") resp='{"id":"kv-1"}' ;;
  "GET /postgres/pg-1"|"GET /key-value/kv-1") resp='{"status":"available"}' ;;
  "GET /postgres/pg-1/connection-info"|"GET /key-value/kv-1/connection-info") resp='{"internalConnectionString":"redis://stub"}' ;;
  "POST /services")
    if [[ "$body" == *'"type":"web_service"'* ]]; then
      resp='{"service":{"id":"srv-web","serviceDetails":{"url":"https://web.example.test"}},"deployId":"dep-web"}'
    else
      resp='{"service":{"id":"srv-worker","serviceDetails":{}},"deployId":"dep-worker"}'
    fi ;;
  "GET /services/"*"/deploys/dep-retry")
    if [ "${STUB_DEPLOY_FAIL:-}" = repeated ]; then resp='{"status":"update_failed"}'; else resp='{"status":"live"}'; fi ;;
  "GET /services/srv-web/deploys/dep-web"|"GET /services/srv-worker/deploys/dep-worker")
    if [ -n "${STUB_DEPLOY_FAIL:-}" ]; then resp='{"status":"update_failed"}'; else resp='{"status":"live"}'; fi ;;
  "POST /services/"*"/deploys") resp='{"id":"dep-retry"}' ;;
  "GET /services/"*"/deploys?limit=3") resp='[{"deploy":{"id":"dep-1","status":"live","createdAt":"t0","trigger":"api"}}]' ;;
  "GET /services/"*"/events?limit=30") resp='[{"event":{"id":"evt-1","timestamp":"t1","type":"server_failed","details":{}},"cursor":"c"}]' ;;
  "GET /logs?"*)
    if [ "${STUB_DEPLOY_FAIL:-}" = transient ] || [ "${STUB_DEPLOY_FAIL:-}" = repeated ]; then
      resp='{"hasMore":false,"logs":[{"id":"l1","timestamp":"t2","message":"PG::ConnectionBad: connection to server at 10.0.0.1, port 5432 failed: Connection refused"}]}'
    else
      resp='{"hasMore":false,"logs":[{"id":"l1","timestamp":"t2","message":"STUB LOG LINE"}]}'
    fi ;;
  "POST /services/srv-web/jobs")
    n=$(( $(grep -c '^POST /services/srv-web/jobs' "$STUB_DIR/calls.log") ))
    st=succeeded
    if [ -n "${STUB_FAIL_JOB:-}" ] && [[ "$body" == *"$STUB_FAIL_JOB"* ]]; then st=failed; fi
    echo "$st" > "$STUB_DIR/job-$n"
    resp="{\"id\":\"job-$n\"}" ;;
  "GET /services/srv-web/jobs/job-"*) resp="{\"status\":\"$(cat "$STUB_DIR/${path##*/}")\"}" ;;
  "DELETE "*) code=204; resp='' ;;
  "GET /services?limit=100"|"GET /postgres?limit=100"|"GET /key-value?limit=100") resp='[]' ;;
  *) code=404; resp='{"message":"stub: unexpected call"}' ;;
esac
printf '%s' "$resp" > "$out"
printf '%s' "$code"
